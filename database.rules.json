{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "saint-eloi-2026": {
        "data": {
          ".read": "auth != null && auth.provider === 'password' && (auth.token.email === 'access2002@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access9425@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access7890@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access6930@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access1234@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access0722@sainteloi26-371e3.firebaseapp.com') && root.child('events/saint-eloi-2026/members').child(auth.uid).exists()",
          ".write": "auth != null && auth.provider === 'password' && (auth.token.email === 'access2002@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access9425@sainteloi26-371e3.firebaseapp.com' || auth.token.email === 'access6930@sainteloi26-371e3.firebaseapp.com') && (root.child('events/saint-eloi-2026/members').child(auth.uid).child('role').val() === 'organizer' || root.child('events/saint-eloi-2026/members').child(auth.uid).child('role').val() === 'admin')",
          "tables": {
            "$id": {
              ".validate": "newData.hasChildren(['capacity'])",
              "capacity": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "reservations": {
            "$id": {
              ".validate": "newData.hasChildren(['reservedBy','contactedOrganizer','status','participants','version','createdBy','createdAt','updatedBy','updatedAt'])",
              "reservedBy": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "phone": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "contactedOrganizer": {
                ".validate": "newData.val() === 'Antonin Blanckaert' || newData.val() === 'Antonin Bassut' || newData.val() === 'Théotime Laloua' || newData.val() === 'Robin Maret'"
              },
              "notes": {
                ".validate": "newData.isString() && newData.val().length <= 2000"
              },
              "status": {
                ".validate": "newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'cancelled'"
              },
              "version": {
                ".validate": "newData.isNumber() && newData.val() >= 1"
              },
              "createdBy": {
                ".validate": "newData.isString()"
              },
              "createdAt": {
                ".validate": "newData.isString()"
              },
              "updatedBy": {
                ".validate": "newData.isString()"
              },
              "updatedAt": {
                ".validate": "newData.isString()"
              },
              "participants": {
                "$pid": {
                  ".validate": "newData.hasChildren(['name','tableId','seat','arrived','paid']) && (!newData.child('arrived').val() || newData.child('paid').val() === true)",
                  "name": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
                  },
                  "tableId": {
                    ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^t[0-9]+-[123]$/))"
                  },
                  "seat": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
                  },
                  "arrived": {
                    ".validate": "newData.isBoolean()"
                  },
                  "paid": {
                    ".validate": "newData.isBoolean()"
                  },
                  "arrivedAt": {
                    ".validate": "newData.isString()"
                  },
                  "paidAt": {
                    ".validate": "newData.isString()"
                  },
                  "arrivedBy": {
                    ".validate": "newData.isString()"
                  },
                  "paidBy": {
                    ".validate": "newData.isString()"
                  },
                  "$other": {
                    ".validate": false
                  },
                  ".write": "auth != null && auth.provider === 'password' && (auth.token.email === 'access0722@sainteloi26-371e3.firebaseapp.com') && root.child('events/saint-eloi-2026/data/reservations').child($id).child('status').val() === 'accepted' && data.exists() && newData.exists() && newData.child('name').val() === data.child('name').val() && newData.child('tableId').val() === data.child('tableId').val() && newData.child('seat').val() === data.child('seat').val() && newData.child('arrived').isBoolean() && newData.child('paid').isBoolean() && (!newData.child('arrived').val() || newData.child('paid').val() === true) && root.child('events/saint-eloi-2026/members').child(auth.uid).child('role').val() === 'entry'"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false,
            "name": {
              ".validate": "newData.isString()"
            },
            "role": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
